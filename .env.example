# Server
PORT=3000

# Supabase (get from https://supabase.com/dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key
# Optional aliases also supported by backend:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Stripe (get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# AI Services
FAL_API_KEY=your-fal-key
REPLICATE_API_KEY=your-replicate-key

# Remotion Lambda (AWS) - Required for GIF rendering
# See: https://www.remotion.dev/docs/lambda/setup
#
# Setup steps:
# 1. Configure AWS credentials: aws configure
# 2. Deploy function: npx remotion lambda functions deploy
# 3. Deploy site: npx remotion lambda sites create src/index.ts --site-name=pixar-gif
# 4. Copy the function name and serve URL below
#
REMOTION_AWS_REGION=us-east-1
REMOTION_FUNCTION_NAME=remotion-render-xxxx
REMOTION_SERVE_URL=https://remotionlambda-xxxxx.s3.us-east-1.amazonaws.com/sites/pixar-gif
# Optional: pre-rendered transparent WebM overlay for deterministic effects
# If omitted, Main composition falls back to inline effects rendering.
EFFECTS_OVERLAY_URL=https://remotionlambda-xxxxx.s3.us-east-1.amazonaws.com/effects/effects-overlay-yyyymmddThhmmssZ.webm
# Render tuning (speed): defaults are used if these are omitted
# With current 486px/10fps profile, these defaults increase parallelism materially.
# IMPORTANT: Set only one chunking strategy:
# - REMOTION_CONCURRENCY (recommended), OR
# - REMOTION_FRAMES_PER_LAMBDA
REMOTION_SCALE=0.45
REMOTION_EVERY_NTH_FRAME=3
REMOTION_CONCURRENCY=24
REMOTION_CONCURRENCY_PER_LAMBDA=1
# REMOTION_FRAMES_PER_LAMBDA=8

# Async generation job worker
GENERATION_JOB_POLL_MS=3000
GENERATION_JOB_STALE_MINUTES=30
GENERATION_JOB_WORKER_CONCURRENCY=4

# Monitoring/admin API key for /api/monitoring/admin/* endpoints
# Generate a random long string and keep it private.
MONITORING_API_KEY=replace-with-random-secret

# AWS credentials (if not using ~/.aws/credentials)
# AWS_ACCESS_KEY_ID=xxx
# AWS_SECRET_ACCESS_KEY=xxx

# Frontend URL (for Stripe redirects)
FRONTEND_URL=http://localhost:3000
